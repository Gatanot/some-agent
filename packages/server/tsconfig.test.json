{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node", "vitest"],
		"paths": {
			"@gatanot/orrery-agent-core": ["../agent/src/index.ts"],
			"@gatanot/orrery-ai": ["../ai/src/index.ts"],
			"@gatanot/orrery-ai/*": ["../ai/src/*.ts", "../ai/src/providers/*.ts"],
			"@gatanot/orrery-protocol": ["../protocol/src/index.ts"],
			"@gatanot/orrery-telemetry": ["../telemetry/src/index.ts"]
		}
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
