{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@gatanot/orrery-chord": ["./packages/chord/src/index.ts"],
			"@gatanot/orrery-chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@gatanot/orrery-chord/context": ["./packages/chord/src/context/index.ts"],
			"@gatanot/orrery-chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@gatanot/orrery-chord/node": ["./packages/chord/src/node.ts"],
			"@gatanot/orrery-telemetry": ["./packages/telemetry/src/index.ts"],
			"@gatanot/orrery-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@gatanot/orrery-ai": ["./packages/ai/src/index.ts"],
			"@gatanot/orrery-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@gatanot/orrery-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@gatanot/orrery-ai/dist/*": ["./packages/ai/src/*"],
			"@gatanot/orrery-durable": ["./packages/durable/src/index.ts"],
			"@gatanot/orrery-durable/*": ["./packages/durable/src/*"],
			"@gatanot/orrery-agent-core": ["./packages/agent/src/index.ts"],
			"@gatanot/orrery-agent-core/harness/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@gatanot/orrery-agent-core/experimental/pico3": [
				"./packages/agent/src/harness/pico3/index.ts"
			],
			"@gatanot/orrery-agent-core/node": ["./packages/agent/src/node.ts"],
			"@gatanot/orrery-agent-core/*": [
				"./packages/agent/src/*.ts",
				"./packages/agent/src/*/index.ts",
				"./packages/agent/src/*"
			],
			"@gatanot/orrery-session-backend-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@gatanot/orrery": ["./packages/coding-agent/src/index.ts"],
			"@gatanot/orrery/web-api": ["./packages/coding-agent/src/web-api.ts"],
			"@gatanot/orrery/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@gatanot/orrery/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@gatanot/orrery/*": ["./packages/coding-agent/src/*"],
			"@gatanot/orrery-protocol": ["./packages/protocol/src/index.ts"],
			"@gatanot/orrery-protocol/*": ["./packages/protocol/src/*"],
			"@gatanot/orrery-client": ["./packages/client/src/index.ts"],
			"@gatanot/orrery-client/unix": ["./packages/client/src/unix.ts"],
			"@gatanot/orrery-client/*": ["./packages/client/src/*"],
			"@gatanot/orrery-server": ["./packages/server/src/index.ts"],
			"@gatanot/orrery-server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@gatanot/orrery-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@gatanot/orrery-tui": ["./packages/tui/src/index.ts"],
			"@gatanot/orrery-tui/*": ["./packages/tui/src/*"],
			"@gatanot/orrery-agent-old": ["./packages/agent-old/src/index.ts"],
			"@gatanot/orrery-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/*/extensions/**/*", "packages/session-backends/*/src/**/*", "packages/session-backends/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
